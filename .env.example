# PLANTILLA SIN SECRETOS. Copiala a un archivo llamado exactamente  .env  y pega el token.
# Los scripts la leen con python-dotenv. El agente no lee este archivo: hay un hook que lo impide.
#
# Windows, forma segura de crearlo (evita que quede como .env.txt):
#     copy .env.example .env
#     notepad .env
# Mac / Linux:
#     cp .env.example .env
#     nano .env

# Private App token del portal 6925781 (UANDES / UDEP Online).
# Scopes: forms · crm.objects.contacts.read · crm.objects.contacts.write · automation
# Pedile el valor a Roman (esta en el paquete original) o generalo en HubSpot:
#   Configuracion -> Integraciones -> Private Apps
HUBSPOT_TOKEN=pega-aca-el-token-que-empieza-con-pat-na1

# Portal. No cambiar: los scripts abortan si el token responde otro portalId.
HUBSPOT_PORTAL_ID=6925781

# Prefijo de los correos de prueba. Todo lo que se cree en la pasada lleva este patron.
QA_EMAIL_BASE=qa@5minutos.io

# Telefono de prueba, el mismo en los 80 envios.
QA_TELEFONO=+51900000000

# 1 = no envia formularios de verdad, solo simula. Arranca en 1 a proposito.
# Cambiar a 0 recien cuando Santiago apruebe y el equipo comercial este avisado.
DRY_RUN=1
